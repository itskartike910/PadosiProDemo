# =============================================================================
# PadosiPro Backend — Environment Variables
# Copy this to .env and fill in your values.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────
# For SQLite (default / local dev): leave DATABASE_URL as sqlite:///./padosipro.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/padosipro
DATABASE_URL=sqlite+aiosqlite:///./padosipro.db

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate a long random secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_super_secret_jwt_key_minimum_32_chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── OTP Settings ──────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ── Email / SMTP ──────────────────────────────────────────────────────────
# Development: leave empty to use Ethereal (auto-creates test account, logs preview URL)
# Production: fill in your SMTP credentials
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@padosipro.com
SMTP_FROM_NAME=PadosiPro

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=PadosiPro
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
